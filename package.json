{
  "name": "carrycut",
  "version": "2.0.0",
  "description": "Session guardian: simulate which Claude Code skills survive auto-compaction",
  "type": "module",
  "bin": {
    "carrycut": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
